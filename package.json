{
  "name": "hunter-contracts",
  "version": "1.0.0",
  "description": "MongoDB Express Node Typescript REST-API",
  "homepage": "https://github.com/TheYori/Hunter-Contracts#readme",
  "bugs": {
    "url": "https://github.com/TheYori/Hunter-Contracts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheYori/Hunter-Contracts.git"
  },
  "license": "ISC",
  "author": "TheYori",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "rm -rf -/dist && tsc",
    "start-dev": "npx nodemon",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "npx eslint"
  },
  "nodemonConfig": {
    "verbose": false,
    "watch": [
      "src"
    ],
    "ext": "js,ts",
    "exec": "npx ts-node ./src/index.ts",
    "ignore": [
      "node_modules"
    ]
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv-flow": "^4.1.0",
    "express": "^5.2.1",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.0.0",
    "mongoose": "^9.1.5",
    "nodemon": "^3.1.11",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/joi": "^17.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.1.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
